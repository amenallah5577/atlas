PORT=3000

# Atlas accounts, owner administration, and research
ATLAS_STORAGE=mongodb
ATLAS_LLM_PROVIDER=groq
ATLAS_GROQ_API_KEY=
ATLAS_TAVILY_API_KEY=
ATLAS_FREE_PROVIDERS_CONFIRMED=false
# Provision the owner using node scripts/atlas-owner.js, then retain the generated ID.
ATLAS_OWNER_EMAIL=
ATLAS_OWNER_ID=
# Social sign-in: register each callback URL before enabling a provider.
# Public origin only, without a path. Use HTTPS in production.
ATLAS_PUBLIC_URL=http://127.0.0.1:3000
ATLAS_GOOGLE_CLIENT_ID=
ATLAS_GOOGLE_CLIENT_SECRET=
ATLAS_GITHUB_CLIENT_ID=
ATLAS_GITHUB_CLIENT_SECRET=
ATLAS_MICROSOFT_CLIENT_ID=
ATLAS_MICROSOFT_CLIENT_SECRET=

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ecosphere

# AI and search providers
GROQ_API_KEY=your_groq_api_key
# Choose an available Groq model with JSON object mode; no automatic fallback.
GROQ_MODEL=
TAVILY_API_KEY=your_tavily_api_key

# Signed guest sessions
SESSION_SECRET=replace_with_a_long_random_secret

# Optional Clerk accounts. Leave both blank to keep guest-only mode.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Basic-auth credentials for /admin.html and /api/admin/history
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
